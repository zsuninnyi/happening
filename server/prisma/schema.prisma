// Prisma ORM — SQLite for zero-Docker local runs.
// To use PostgreSQL later, change provider to "postgresql" and set DATABASE_URL accordingly.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum Category {
  news
  markets
  disasters
}

enum Severity {
  low
  medium
  high
}

enum Channel {
  email
  slack
}

enum DeliveryStatus {
  sent
  failed
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String
  password   String
  role       Role
  createdAt  DateTime   @default(now())
  alerts     Alert[]
  deliveries Delivery[]
  events     Event[]    @relation("EventCreator")
}

model Alert {
  id           String     @id @default(cuid())
  userId       String
  name         String
  /// JSON array of Category values, e.g. ["news","markets"]
  categories   Json
  minSeverity  Severity   @default(low)
  channel      Channel
  destination  String
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]

  @@index([userId])
  @@index([enabled])
}

model Event {
  id          String     @id @default(cuid())
  externalId  String?
  title       String
  summary     String?
  category    Category
  severity    Severity
  createdById String?
  createdAt   DateTime   @default(now())
  createdBy   User?      @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries  Delivery[]

  @@index([externalId])
  @@index([category])
}

model Delivery {
  id          String         @id @default(cuid())
  eventId     String
  alertId     String
  userId      String
  dedupeKey   String
  channel     Channel
  destination String
  status      DeliveryStatus
  error       String?
  createdAt   DateTime       @default(now())
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alert       Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, dedupeKey])
  @@index([userId])
  @@index([eventId])
}
